<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheelbot_reference">
  <xacro:include filename="$(find rdk_transport_description)/urdf/wheelbot_reference/wheellegbot/base.urdf.xacro"/>
  <xacro:include filename="$(find rdk_transport_description)/urdf/wheelbot_reference/wheellegbot/sensor/imu.urdf.xacro"/>
  <xacro:include filename="$(find rdk_transport_description)/urdf/wheelbot_reference/wheellegbot/sensor/laser.urdf.xacro"/>
  <xacro:include filename="$(find rdk_transport_description)/urdf/wheelbot_reference/wheellegbot/sensor/camera.urdf.xacro"/>
  <xacro:include filename="$(find rdk_transport_description)/urdf/wheelbot_reference/wheellegbot/actuator/wheel.urdf.xacro"/>
  <xacro:include filename="$(find rdk_transport_description)/urdf/wheelbot_reference/wheellegbot/actuator/caster.urdf.xacro"/>

  <xacro:base_xacro xyz="0.27 0.23 0.19"/>
  <xacro:imu_xacro xyz="0.0 0.0 0.02"/>
  <xacro:camera_xacro xyz="0.13 0.0 0.11"/>
  <xacro:laser_xacro xyz="0.0 0.0 0.115"/>
  <xacro:wheel_xacro wheel_name="left_wheel" xyz="0 0.14 -0.095"/>
  <xacro:wheel_xacro wheel_name="right_wheel" xyz="0 -0.14 -0.095"/>
  <xacro:caster_xacro caster_name="front_caster" xyz="0.08 0 -0.115"/>
  <xacro:caster_xacro caster_name="back_caster" xyz="-0.08 0 -0.115"/>
</robot>
