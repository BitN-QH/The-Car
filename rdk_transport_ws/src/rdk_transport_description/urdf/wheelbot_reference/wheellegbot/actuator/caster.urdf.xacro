<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rdk_transport_description)/urdf/wheelbot_reference/wheellegbot/common_inertia.xacro"/>

  <xacro:macro name="caster_xacro" params="caster_name xyz">
    <link name="${caster_name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.04"/>
        </geometry>
        <material name="wheelbot_caster_yellow">
          <color rgba="1.0 1.0 0 0.8"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.04"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia m="0.01" r="0.04"/>
    </link>

    <joint name="${caster_name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${caster_name}_link"/>
      <origin xyz="${xyz}"/>
    </joint>
  </xacro:macro>
</robot>
