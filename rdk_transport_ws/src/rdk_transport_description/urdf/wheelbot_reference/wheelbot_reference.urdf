<?xml version="1.0"?>
<robot name="wheelbot_reference">
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.23 0.19"/>
      </geometry>
      <material name="wheelbot_base_blue">
        <color rgba="0.1 0.1 1.0 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.23 0.19"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0116667" ixy="0.0" ixz="0.0" iyy="0.0128333" iyz="0.0" izz="0.0216333"/>
    </inertial>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <origin xyz="0.0 0.0 0.151" rpy="0.0 0.0 0.0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="wheelbot_sensor_black">
        <color rgba="0 0 0 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0000333" ixy="0.0" ixz="0.0" iyy="0.0000333" iyz="0.0" izz="0.0000333"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.02"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.10 0.02"/>
      </geometry>
      <material name="wheelbot_camera_black">
        <color rgba="0 0 0 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.10 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000867" ixy="0.0" ixz="0.0" iyy="0.0000067" iyz="0.0" izz="0.0000867"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.13 0.0 0.11"/>
  </joint>

  <link name="laser_cylinder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.04"/>
      </geometry>
      <material name="wheelbot_laser_black">
        <color rgba="0 0 0 0.5"/>
      </material>
    </visual>
  </link>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
      <material name="wheelbot_laser_body_black">
        <color rgba="0 0 0 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000063" ixy="0.0" ixz="0.0" iyy="0.0000063" iyz="0.0" izz="0.0000100"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="laser_cylinder_link"/>
    <child link="laser"/>
    <origin xyz="0.0 0.0 0.02"/>
  </joint>

  <joint name="laser_cylinder_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_cylinder_link"/>
    <origin xyz="0.0 0.0 0.115"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.05"/>
      </geometry>
      <material name="wheelbot_wheel_yellow">
        <color rgba="1.0 1.0 0 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0004938" ixy="0.0" ixz="0.0" iyy="0.0004938" iyz="0.0" izz="0.0009000"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.14 -0.095"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.05"/>
      </geometry>
      <material name="wheelbot_wheel_yellow">
        <color rgba="1.0 1.0 0 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0004938" ixy="0.0" ixz="0.0" iyy="0.0004938" iyz="0.0" izz="0.0009000"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.14 -0.095"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="wheelbot_caster_yellow">
        <color rgba="1.0 1.0 0 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000064" ixy="0.0" ixz="0.0" iyy="0.0000064" iyz="0.0" izz="0.0000064"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.08 0 -0.115"/>
  </joint>

  <link name="back_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="wheelbot_caster_yellow">
        <color rgba="1.0 1.0 0 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000064" ixy="0.0" ixz="0.0" iyy="0.0000064" iyz="0.0" izz="0.0000064"/>
    </inertial>
  </link>

  <joint name="back_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_caster_link"/>
    <origin xyz="-0.08 0 -0.115"/>
  </joint>
</robot>
