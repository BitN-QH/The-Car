<?xml version="1.0"?>
<package format="3">
  <name>rdk_transport_perception_cpp</name>
  <version>0.1.0</version>
  <description>C++ perception bridge for the RDK X5 transport robot.</description>
  <maintainer email="sunrise@example.com">sunrise</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ai_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>dnn_node_example</exec_depend>
  <exec_depend>hobot_codec</exec_depend>
  <exec_depend>hobot_shm</exec_depend>
  <exec_depend>hobot_usb_cam</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
